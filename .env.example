APP_NAME=Kcalm API
APP_ENV=development
API_V1_PREFIX=/api/v1
# JSON array of exact frontend origins; wildcard origins are rejected.
CORS_ORIGINS=["https://kcalm-app.vercel.app","http://localhost:3000"]
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/kcalm
JWT_SECRET=change-this-development-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Shared PostgreSQL rate limits: positive request counts and window seconds.
RATE_LIMIT_REGISTER_REQUESTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_FORGOT_PASSWORD_REQUESTS=5
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_SECONDS=300
RATE_LIMIT_AI_REQUESTS=30
RATE_LIMIT_AI_WINDOW_SECONDS=60
RATE_LIMIT_USDA_IMPORT_REQUESTS=20
RATE_LIMIT_USDA_IMPORT_WINDOW_SECONDS=60

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
USDA_API_KEY=DEMO_KEY
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=10

# Recipe images are generated only by the admin endpoint or batch command.
OPENAI_IMAGE_MODEL=gpt-image-2.6-flare
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_COMPLEXITY=low
OPENAI_IMAGE_TIMEOUT_SECONDS=180
IMAGE_STORAGE_BUCKET=
# Use auto for Cloudflare R2; select the bucket region for AWS S3.
IMAGE_STORAGE_REGION=us-east-1
# Optional for AWS S3; example: https://<account-id>.r2.cloudflarestorage.com
IMAGE_STORAGE_ENDPOINT_URL=
# Public bucket/CDN URL, for example https://images.example.com
IMAGE_STORAGE_PUBLIC_BASE_URL=
IMAGE_STORAGE_ACCESS_KEY_ID=
IMAGE_STORAGE_SECRET_ACCESS_KEY=
